# Example Environment Variables for Local Development or Remote Deployment

# --- Option 1: Fast Hosted Cloud Model (Recommended for 100% Free Public Deployment) ---
# Sign up at https://console.groq.com and generate a free API key
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# --- Option 2: OpenAI / OpenRouter / Together AI ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- Option 3: Remote or Local Ollama Instance ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:4b

# --- CORS & Origins ---
# Comma-separated list or * for all
ALLOWED_ORIGINS=https://ai-study-assistant-rag.vercel.app,https://ai-study-assistant-rag-gamma.vercel.app
FRONTEND_URL=https://ai-study-assistant-rag-gamma.vercel.app
